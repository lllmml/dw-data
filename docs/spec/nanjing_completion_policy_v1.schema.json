{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nanjing_completion_policy_v1",
  "description": "Completion policy for the v1 derived delivery. Contract: docs/spec/nanjing_v1_completion_export.md 1.1.0, incorporating docs/spec/revisions/nanjing_v1_completion_export_revision_001.md. The field set, enums and ranges are unchanged by that revision; only the generated-row field semantics and the delivery manifest scope changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "materialize_tiers",
    "enabled_rules",
    "max_reference_closure_depth",
    "placement_endpoint_bus"
  ],
  "properties": {
    "schema_version": {
      "const": "nanjing_completion_policy_v1"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "materialize_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SAME_STATION",
          "CROSS_STATION"
        ]
      }
    },
    "enabled_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACCEPTED_DETERMINISTIC_RECOVERY_V1",
          "CROSS_CASE_REFERENCE_COPY_V1",
          "PLACEMENT_MISSING_ENDPOINT_BUS_V1"
        ]
      }
    },
    "max_reference_closure_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "placement_endpoint_bus": {
      "type": "boolean"
    }
  }
}
